# ------------------------------------------
# API Name
# ------------------------------------------

spring.application.name=libraryapi

# ------------------------------------------
# API Version
# ------------------------------------------

app.version=1.0.0

# ------------------------------------------
# API Developer
# ------------------------------------------

app.developer=Jabier Zurro Aduriz

# ------------------------------------------
# Server port configuration
# ------------------------------------------

server.port=8080

# ------------------------------------------
# MySQL Data Base configuration
# ------------------------------------------

spring.datasource.url=jdbc:mysql://localhost:3306/library_db?useSSL=false&requireSSL=false&serverTimezone=UTC
spring.datasource.username=CHANGE_ME
spring.datasource.password=CHANGE_ME

# ------------------------------------------
# Flyway
# ------------------------------------------

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.encoding=UTF-8

# ------------------------------------------
# JPA / Hibernate
# ------------------------------------------

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect


# ------------------------------------------
# JWT Configuration
# ------------------------------------------
security.jwt.secret=CHANGE_ME
security.jwt.secret.format=HEX
security.jwt.issuer=libraryapi
security.jwt.expiration=1800000